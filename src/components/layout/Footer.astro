---
import * as m from "@/paraglide/messages.js";

const year = new Date().getFullYear();
---

<footer style="padding: 80px 0 48px;">
  <hr class="section-divider" />
  <div
    class="mx-auto flex flex-col md:flex-row items-center justify-between"
    style="max-width: 1078px; padding: 0 28px; margin-top: 40px; gap: 28px;"
  >
    <p
      class="font-dm-sans font-normal tracking-tight"
      style="font-size: 12px; line-height: 1.32; color: rgba(255, 255, 255, 0.3); letter-spacing: 0.01em;"
    >
      {m.footer_copyright({ year })}
    </p>
    <div class="flex items-center" style="gap: 32px;">
      <a
        href="https://github.com/clikzz"
        target="_blank"
        rel="noopener noreferrer"
        class="font-dm-sans font-normal tracking-tight transition-all duration-300"
        style="font-size: 12px; line-height: 1.32; color: rgba(255, 255, 255, 0.3); letter-spacing: 0.01em;"
        onmouseover="this.style.color='#ffffff'"
        onmouseout="this.style.color='rgba(255, 255, 255, 0.3)'"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/alvaroloyola"
        target="_blank"
        rel="noopener noreferrer"
        class="font-dm-sans font-normal tracking-tight transition-all duration-300"
        style="font-size: 12px; line-height: 1.32; color: rgba(255, 255, 255, 0.3); letter-spacing: 0.01em;"
        onmouseover="this.style.color='#ffffff'"
        onmouseout="this.style.color='rgba(255, 255, 255, 0.3)'"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
