---
import * as m from "@/paraglide/messages.js";

const email = "alv.loyolamendoza@gmail.com";
const phone = "+569 6456 8222";
const whatsappUrl = "https://wa.me/56964568222";
---

<section id="contact" style="padding: 96px 0 120px; position: relative;">
  <div
    style="max-width: 1078px; padding: 0 28px; margin: 0 auto; position: relative;"
  >
    <span class="section-number reveal" style="top: -0.15em; left: 0;">05</span>

    <h2
      class="reveal font-raleway font-semibold tracking-tight text-frost-white"
      style="font-size: clamp(29px, 4vw, 42px); line-height: 1.15; margin-bottom: 56px; letter-spacing: -0.02em; position: relative; z-index: 1;"
    >
      {m.section_contact_title()}
    </h2>

    <div
      class="reveal"
      style="display: flex; flex-direction: column; gap: 48px;"
    >
      <!-- Email row -->
      <div class="flex flex-col md:flex-row md:items-end" style="gap: 32px;">
        <div class="flex-1">
          <p
            class="font-dm-sans font-normal tracking-tight"
            style="font-size: 12px; line-height: 1.32; margin-bottom: 12px; color: rgba(255, 255, 255, 0.25); letter-spacing: 0.03em;"
          >
            {m.contact_email_label()}
          </p>
          <a
            href={`mailto:${email}`}
            class="font-raleway font-semibold tracking-tight text-frost-white transition-all duration-300"
            style="
              font-size: clamp(32px, 5vw, 56px);
              line-height: 1.1;
              letter-spacing: -0.03em;
            "
            onmouseover="this.style.color='rgba(255,255,255,0.6)'"
            onmouseout="this.style.color='#ffffff'"
          >
            {email}
          </a>
        </div>

        <div class="flex items-end" style="gap: 14px;">
          <a
            href={`mailto:${email}`}
            class="ghost-action inline-flex items-center"
            style="padding: 6px 24px; gap: 8px; margin-bottom: 4px;"
          >
            {m.button_send_email()}
            <svg
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 2h8v8M10 2L1 11"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <button
            type="button"
            id="copy-email-btn"
            class="ghost-action inline-flex items-center"
            style="padding: 6px 24px; margin-bottom: 4px;"
            data-email={email}
            data-success={m.contact_copy_success()}
            data-label={m.contact_copy_email()}
          >
            {m.contact_copy_email()}
          </button>
        </div>
      </div>

      <!-- Phone row -->
      <div
        class="flex flex-col md:flex-row md:items-end"
        style="gap: 32px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.04);"
      >
        <div class="flex-1">
          <p
            class="font-dm-sans font-normal tracking-tight"
            style="font-size: 12px; line-height: 1.32; margin-bottom: 12px; color: rgba(255, 255, 255, 0.25); letter-spacing: 0.03em;"
          >
            {m.contact_phone_label()}
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-raleway font-semibold tracking-tight text-frost-white transition-all duration-300"
            style="
              font-size: clamp(32px, 5vw, 56px);
              line-height: 1.1;
              letter-spacing: -0.03em;
            "
            onmouseover="this.style.color='rgba(255,255,255,0.6)'"
            onmouseout="this.style.color='#ffffff'"
          >
            {phone}
          </a>
        </div>

        <div class="flex items-end" style="gap: 14px;">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ghost-action inline-flex items-center"
            style="padding: 6px 24px; gap: 8px; margin-bottom: 4px;"
          >
            {m.contact_whatsapp()}
            <svg
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 2h8v8M10 2L1 11"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <button
            type="button"
            id="copy-phone-btn"
            class="ghost-action inline-flex items-center"
            style="padding: 6px 24px; margin-bottom: 4px;"
            data-phone={phone}
            data-success={m.contact_copy_success()}
            data-label={m.contact_copy_phone()}
          >
            {m.contact_copy_phone()}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  var emailBtn = document.getElementById("copy-email-btn");
  if (emailBtn) {
    emailBtn.addEventListener("click", function () {
      var email = emailBtn.getAttribute("data-email");
      var successText = emailBtn.getAttribute("data-success") || "Copied!";
      var originalText = emailBtn.getAttribute("data-label") || "Copy email";
      if (!email) return;
      try {
        navigator.clipboard.writeText(email).then(function () {
          emailBtn.style.minWidth = emailBtn.offsetWidth + "px";
          emailBtn.textContent = successText;
          emailBtn.style.color = "rgb(160, 224, 171)";
          setTimeout(function () {
            emailBtn.textContent = originalText;
            emailBtn.style.color = "";
            emailBtn.style.minWidth = "";
          }, 2000);
        });
      } catch (e) {
        window.location.href = "mailto:" + email;
      }
    });
  }

  var phoneBtn = document.getElementById("copy-phone-btn");
  if (phoneBtn) {
    phoneBtn.addEventListener("click", function () {
      var phone = phoneBtn.getAttribute("data-phone");
      var successText = phoneBtn.getAttribute("data-success") || "Copied!";
      var originalText = phoneBtn.getAttribute("data-label") || "Copy phone";
      if (!phone) return;
      try {
        navigator.clipboard.writeText(phone).then(function () {
          phoneBtn.style.minWidth = phoneBtn.offsetWidth + "px";
          phoneBtn.textContent = successText;
          phoneBtn.style.color = "rgb(160, 224, 171)";
          setTimeout(function () {
            phoneBtn.textContent = originalText;
            phoneBtn.style.color = "";
            phoneBtn.style.minWidth = "";
          }, 2000);
        });
      } catch (e) {}
    });
  }
</script>
