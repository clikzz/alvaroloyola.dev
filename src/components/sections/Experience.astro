---
import { experiences } from "@/data/content.js";
import I18nText from "@/components/I18nText.astro";
import { getMessage } from "@/lib/i18n";

const INITIAL_COUNT = 2;
const visibleExperiences = experiences.slice(0, INITIAL_COUNT);
const hiddenExperiences = experiences.slice(INITIAL_COUNT);

function formatDate(dateStr: string): string {
  const [year, month] = dateStr.split("-");
  const d = new Date(Number(year), Number(month) - 1);
  return d.toLocaleDateString("en", { year: "numeric", month: "short" });
}

const hues = ["170", "35", "5", "200"];
---

<section id="experience" style="padding: 96px 0; position: relative;">
  <div
    style="max-width: 1078px; padding: 0 28px; margin: 0 auto; position: relative;"
  >
    <span class="section-number reveal" style="top: -0.15em; left: 0;">02</span>

    <h2
      class="reveal font-raleway font-semibold tracking-tight text-frost-white"
      style="font-size: clamp(29px, 4vw, 42px); line-height: 1.15; margin-bottom: 56px; letter-spacing: -0.02em; position: relative; z-index: 1;"
    >
      <I18nText keyName="section_experience_title" />
    </h2>

    <div
      class="expandable-root"
      data-expand-label={getMessage("en", "button_view_more")}
      data-collapse-label={getMessage("en", "button_view_less")}
    >
      <div class="visible-slot flex flex-col">
        {
          visibleExperiences.map((exp, i) => {
            const hue = hues[i % hues.length];
            return (
              <article
                class="reveal group"
                style={`transition-delay: ${i * 150 + 200}ms`}
              >
                <div
                  class="flex flex-col md:flex-row md:items-start"
                  style="gap: 24px 40px;"
                >
                  <div
                    class="flex items-center shrink-0"
                    style="gap: 12px; min-width: 150px;"
                  >
                    <span
                      style={`
                      display: inline-block;
                      width: 6px;
                      height: 6px;
                      border-radius: 50%;
                      background: hsl(${hue}, 60%, 65%);
                      box-shadow: 0 0 8px hsl(${hue}, 60%, 65%, 0.5);
                      flex-shrink: 0;
                    `}
                    />
                    <span
                      class="font-dm-sans font-normal tracking-tight"
                      style="font-size: 12px; color: rgba(255,255,255,0.22); letter-spacing: 0.04em;"
                    >
                      {formatDate(exp.startDate)}
                      <br class="md:hidden" /> —{" "}
                      {exp.endDate
                        ? formatDate(exp.endDate)
                        : <I18nText keyName="experience_present" />}
                    </span>
                  </div>

                  <div
                    class="relative hidden md:block shrink-0"
                    style="width: 1px; align-self: stretch;"
                  >
                    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));" />
                  </div>

                  <div class="flex-1 min-w-0" style="padding-bottom: 40px;">
                    <h3
                      class="font-dm-sans font-semibold tracking-tight text-frost-white"
                      style="font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 4px;"
                    >
                      <I18nText value={exp.role} />
                    </h3>
                    <p
                      class="font-dm-sans font-normal tracking-tight"
                      style="font-size: 14px; color: rgba(255,255,255,0.35); letter-spacing: 0.01em;"
                    >
                      {exp.company} · <I18nText value={exp.location} />
                    </p>
                    <p
                      class="font-dm-sans font-normal tracking-tight mt-4"
                      style="font-size: 15px; line-height: 1.55; color: rgba(255,255,255,0.42); letter-spacing: -0.005em; max-width: 560px;"
                    >
                      <I18nText value={exp.description} />
                    </p>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      {
        hiddenExperiences.length > 0 && (
          <>
            <div class="hidden-slot hidden flex flex-col">
              {hiddenExperiences.map((exp, i) => {
                const hue = hues[(i + INITIAL_COUNT) % hues.length];
                return (
                  <article class="reveal group">
                    <div
                      class="flex flex-col md:flex-row md:items-start"
                      style="gap: 24px 40px;"
                    >
                      <div
                        class="flex items-center shrink-0"
                        style="gap: 12px; min-width: 150px;"
                      >
                        <span
                          style={`
                          display: inline-block;
                          width: 6px;
                          height: 6px;
                          border-radius: 50%;
                          background: hsl(${hue}, 60%, 65%);
                          box-shadow: 0 0 8px hsl(${hue}, 60%, 65%, 0.5);
                          flex-shrink: 0;
                        `}
                        />
                        <span
                          class="font-dm-sans font-normal tracking-tight"
                          style="font-size: 12px; color: rgba(255,255,255,0.22); letter-spacing: 0.04em;"
                        >
                          {formatDate(exp.startDate)}
                          <br class="md:hidden" /> —{" "}
                          {exp.endDate
                            ? formatDate(exp.endDate)
                            : <I18nText keyName="experience_present" />}
                        </span>
                      </div>

                      <div
                        class="relative hidden md:block shrink-0"
                        style="width: 1px; align-self: stretch;"
                      >
                        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));" />
                      </div>

                      <div class="flex-1 min-w-0" style="padding-bottom: 40px;">
                        <h3
                          class="font-dm-sans font-semibold tracking-tight text-frost-white"
                          style="font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 4px;"
                        >
                          <I18nText value={exp.role} />
                        </h3>
                        <p
                          class="font-dm-sans font-normal tracking-tight"
                          style="font-size: 14px; color: rgba(255,255,255,0.35); letter-spacing: 0.01em;"
                        >
                          {exp.company} · <I18nText value={exp.location} />
                        </p>
                        <p
                          class="font-dm-sans font-normal tracking-tight mt-4"
                          style="font-size: 15px; line-height: 1.55; color: rgba(255,255,255,0.42); letter-spacing: -0.005em; max-width: 560px;"
                        >
                          <I18nText value={exp.description} />
                        </p>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
            <div style="text-align: center; margin-top: 8px;">
              <button
                type="button"
                class="toggle-btn ghost-action"
                style="padding: 6px 24px;"
                aria-expanded="false"
              >
                <I18nText keyName="button_view_more" />
              </button>
            </div>
          </>
        )
      }
    </div>
  </div>
</section>
