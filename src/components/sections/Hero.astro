---
import * as m from "@/paraglide/messages.js";
---

<section
  id="hero"
  class="relative flex items-center justify-center overflow-hidden"
  style="min-height: 100vh;"
>
  <!-- Gradient mesh background -->
  <div
    class="absolute inset-0"
    style="
      background:
        radial-gradient(ellipse 80% 60% at 20% 30%, rgba(160, 224, 171, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 60% 70% at 70% 40%, rgba(255, 172, 46, 0.06) 0%, transparent 50%),
        radial-gradient(ellipse 50% 50% at 40% 80%, rgba(165, 45, 37, 0.05) 0%, transparent 50%),
        radial-gradient(ellipse 40% 40% at 80% 70%, rgba(160, 224, 171, 0.04) 0%, transparent 50%);
    "
  >
  </div>

  <!-- Animated gradient orbs -->
  <div
    class="gradient-orb"
    style="width: 700px; height: 700px; background: radial-gradient(circle, rgba(160, 224, 171, 0.6), transparent 70%); top: -15%; left: -20%; animation: orb-drift-1 20s ease-in-out infinite;"
  >
  </div>
  <div
    class="gradient-orb"
    style="width: 600px; height: 600px; background: radial-gradient(circle, rgba(255, 172, 46, 0.5), transparent 70%); top: 10%; right: -15%; animation: orb-drift-2 25s ease-in-out infinite;"
  >
  </div>
  <div
    class="gradient-orb"
    style="width: 500px; height: 500px; background: radial-gradient(circle, rgba(165, 45, 37, 0.45), transparent 70%); bottom: -10%; left: 25%; animation: orb-drift-3 18s ease-in-out infinite;"
  >
  </div>
  <div
    class="gradient-orb"
    style="width: 450px; height: 450px; background: radial-gradient(circle, rgba(160, 224, 171, 0.5), transparent 70%); top: 40%; left: 50%; animation: orb-drift-4 22s ease-in-out infinite;"
  >
  </div>
  <div
    class="gradient-orb"
    style="width: 350px; height: 350px; background: radial-gradient(circle, rgba(255, 172, 46, 0.4), transparent 70%); bottom: 20%; right: 10%; animation: orb-drift-5 16s ease-in-out infinite;"
  >
  </div>
  <div
    class="gradient-orb"
    style="width: 300px; height: 300px; background: radial-gradient(circle, rgba(165, 45, 37, 0.5), transparent 70%); top: 60%; left: 5%; animation: orb-drift-6 19s ease-in-out infinite;"
  >
  </div>
  <div
    class="gradient-orb"
    style="width: 250px; height: 250px; background: radial-gradient(circle, rgba(160, 224, 171, 0.55), transparent 70%); top: 5%; right: 30%; animation: orb-drift-7 21s ease-in-out infinite;"
  >
  </div>

  <!-- Subtle overlay -->
  <div class="absolute inset-0 bg-midnight-canvas/60" style="z-index: 1;"></div>

  <!-- Display watermark text -->
  <div
    class="display-watermark absolute select-none pointer-events-none"
    style="
      z-index: 2;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      white-space: nowrap;
      opacity: 0.03;
      font-size: clamp(100px, 20vw, 280px);
      letter-spacing: -0.06em;
    "
  >
    DEV
  </div>

  <!-- Hero content -->
  <div
    class="relative text-center"
    style="z-index: 3; max-width: 1078px; padding: 0 28px;"
  >
    <div
      style="display: flex; flex-direction: column; gap: clamp(12px, 2vw, 20px);"
    >
      <h1
        class="reveal font-raleway font-bold tracking-tight"
        style="
          font-size: clamp(54px, 8vw, 120px);
          line-height: 0.95;
          letter-spacing: -0.03em;
          color: #ffffff;
          transition-delay: 100ms;
        "
      >
        <span class="text-gradient">{m.hero_greeting()}</span>
      </h1>

      <p
        class="reveal font-dm-sans font-normal max-w-2xl mx-auto"
        style="
          font-size: clamp(16px, 2.2vw, 22px);
          line-height: 1.45;
          letter-spacing: -0.01em;
          color: rgba(255, 255, 255, 0.55);
          opacity: 0;
          animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 600ms forwards;
        "
      >
        {m.hero_tagline()}
      </p>
    </div>

    <div
      style="margin-top: clamp(40px, 6vw, 64px); opacity: 0; animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 900ms forwards;"
    >
      <a
        href="#projects"
        class="ghost-action inline-flex items-center"
        style="padding: 6px 28px; gap: 10px; font-size: 16px; letter-spacing: -0.01em;"
      >
        {m.hero_cta()}
      </a>
    </div>
  </div>
</section>

<!-- Scroll indicator -->
<div
  class="absolute bottom-8 left-1/2"
  style="z-index: 3; transform: translateX(-50%); opacity: 0; animation: fade-in 1s ease 1.5s forwards;"
>
  <div style="animation: bounce-subtle 2s ease-in-out infinite;">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path
        d="M12 5v14M6 13l6 6 6-6"
        stroke="rgba(255,255,255,0.25)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</div>
