---
import I18nText from "@/components/I18nText.astro";
import { getMessage } from "@/lib/i18n";
---

<section
  id="hero"
  class="relative flex items-center justify-center overflow-hidden"
  style="min-height: 100vh;"
>
  <!-- Gradient mesh background -->
  <div
    class="absolute inset-0"
    style="
      background:
        radial-gradient(ellipse 80% 60% at 20% 30%, rgba(160, 224, 171, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 60% 70% at 70% 40%, rgba(255, 172, 46, 0.06) 0%, transparent 50%),
        radial-gradient(ellipse 50% 50% at 40% 80%, rgba(165, 45, 37, 0.05) 0%, transparent 50%),
        radial-gradient(ellipse 40% 40% at 80% 70%, rgba(160, 224, 171, 0.04) 0%, transparent 50%);
    "
  >
  </div>

  <!-- Animated gradient orbs -->
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 700px; height: 700px; background: radial-gradient(circle, rgba(160, 224, 171, 0.6), transparent 70%); top: -15%; left: -20%; animation: orb-drift-1 20s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 600px; height: 600px; background: radial-gradient(circle, rgba(255, 172, 46, 0.5), transparent 70%); top: 10%; right: -15%; animation: orb-drift-2 25s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 500px; height: 500px; background: radial-gradient(circle, rgba(165, 45, 37, 0.45), transparent 70%); bottom: -10%; left: 25%; animation: orb-drift-3 18s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 450px; height: 450px; background: radial-gradient(circle, rgba(160, 224, 171, 0.5), transparent 70%); top: 40%; left: 50%; animation: orb-drift-4 22s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 350px; height: 350px; background: radial-gradient(circle, rgba(255, 172, 46, 0.4), transparent 70%); bottom: 20%; right: 10%; animation: orb-drift-5 16s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 300px; height: 300px; background: radial-gradient(circle, rgba(165, 45, 37, 0.5), transparent 70%); top: 60%; left: 5%; animation: orb-drift-6 19s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>
  <div
    class="gradient-orb hero-orb-entrance"
    style="width: 250px; height: 250px; background: radial-gradient(circle, rgba(160, 224, 171, 0.55), transparent 70%); top: 5%; right: 30%; animation: orb-drift-7 21s ease-in-out infinite; animation-delay: 1.5s;"
  >
  </div>

  <!-- Subtle overlay -->
  <div class="absolute inset-0 bg-midnight-canvas/60" style="z-index: 1;"></div>

  <!-- Display watermark text -->
  <div
    class="display-watermark absolute select-none pointer-events-none"
    style="
      z-index: 2;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      white-space: nowrap;
      opacity: 0.03;
      font-size: clamp(100px, 20vw, 280px);
      letter-spacing: -0.06em;
    "
  >
    DEV
  </div>

  <!-- Scanline accent -->
  <div class="scanline" id="scanline"></div>

  <!-- Hero content -->
  <div
    class="relative text-center"
    style="z-index: 3; max-width: 1078px; padding: 0 28px;"
  >
    <div
      style="display: flex; flex-direction: column; gap: clamp(12px, 2vw, 20px);"
    >
      <h1
        class="font-raleway font-bold tracking-tight"
        style="
          font-size: clamp(54px, 8vw, 120px);
          line-height: 1.1;
          letter-spacing: -0.03em;
          overflow: visible;
        "
        data-line1-en={getMessage("en", "hero_greeting_line1")}
        data-line1-es={getMessage("es", "hero_greeting_line1")}
        data-line2-en={getMessage("en", "hero_greeting_line2")}
        data-line2-es={getMessage("es", "hero_greeting_line2")}
      >
        <span id="hero-line1" class="sweep-text" aria-label={getMessage("en", "hero_greeting_line1")}></span>
        <br />
        <span id="hero-line2" class="sweep-text" aria-label={getMessage("en", "hero_greeting_line2")}></span>
      </h1>

      <p
        class="reveal font-dm-sans font-normal max-w-2xl mx-auto"
        style="
          font-size: clamp(16px, 2.2vw, 22px);
          line-height: 1.45;
          letter-spacing: -0.01em;
          color: rgba(255, 255, 255, 0.55);
          transition-delay: 100ms;
        "
      >
        <I18nText keyName="hero_tagline" />
      </p>
    </div>

    <div
      class="spring-entrance"
      style="margin-top: clamp(40px, 6vw, 64px);"
    >
      <a
        href="#projects"
        class="ghost-action inline-flex items-center"
        style="padding: 6px 28px; gap: 10px; font-size: 16px; letter-spacing: -0.01em;"
      >
        <I18nText keyName="hero_cta" />
      </a>
    </div>
  </div>
</section>

<!-- Scroll indicator -->
<div
  class="absolute bottom-8 left-1/2"
  style="z-index: 3; transform: translateX(-50%); opacity: 0; animation: fade-in 1s ease 1.5s forwards;"
>
  <div style="animation: bounce-subtle 2s ease-in-out infinite;">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path
        d="M12 5v14M6 13l6 6 6-6"
        stroke="rgba(255,255,255,0.25)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</div>

<script is:inline>
  (function () {
    var h1 = document.querySelector('h1[data-line1-en]');

    var gradientStyle = {
      background: 'linear-gradient(90deg, rgb(160, 224, 171), rgb(255, 172, 46) 50%, rgb(165, 45, 37))',
      WebkitBackgroundClip: 'text',
      WebkitTextFillColor: 'transparent',
      backgroundClip: 'text'
    };

    function initLine(elementId, text, baseDelay, useGradient, animate) {
      var el = document.getElementById(elementId);
      if (!el) return;
      el.textContent = '';
      el.setAttribute('aria-label', text);
      text.split('').forEach(function (char, i) {
        var s = document.createElement('span');
        s.className = 'char-reveal' + (char === ' ' ? ' space' : '');
        s.textContent = char === ' ' ? '\u00A0' : char;
        s.style.animationDelay = animate ? (baseDelay + i * 45) + 'ms' : '0ms';
        if (useGradient) {
          Object.assign(s.style, gradientStyle);
        } else {
          s.style.color = '#ffffff';
        }
        el.appendChild(s);
      });
      requestAnimationFrame(function () {
        el.querySelectorAll('.char-reveal').forEach(function (s) {
          if (!animate) s.style.animationDuration = '0.01ms';
          s.classList.add('revealed');
        });
        el.classList.add('revealed');
      });
    }

    window.renderHeroTitle = function (locale) {
      if (!h1) return;
      var currentLocale = locale === 'es' ? 'es' : 'en';
      var line1Text = h1.getAttribute('data-line1-' + currentLocale) || '';
      var line2Text = h1.getAttribute('data-line2-' + currentLocale) || '';
      var shouldAnimate = !h1.dataset.heroRendered;
      initLine('hero-line1', line1Text, shouldAnimate ? 400 : 0, false, shouldAnimate);
      initLine('hero-line2', line2Text, shouldAnimate ? 400 + line1Text.length * 45 : 0, true, shouldAnimate);
      h1.dataset.heroRendered = 'true';
    };

    window.renderHeroTitle(document.documentElement.dataset.locale || 'en');

    var scanline = document.getElementById('scanline');
    if (scanline) {
      setTimeout(function () {
        scanline.classList.add('active');
      }, 200);
    }

    var springEl = document.querySelector('.spring-entrance');
    if (springEl) {
      setTimeout(function () {
        springEl.classList.add('revealed');
      }, 1200);
    }

    var orbs = document.querySelectorAll('.hero-orb-entrance');
    orbs.forEach(function (orb, i) {
      setTimeout(function () {
        orb.classList.add('revealed');
      }, 100 + i * 80);
    });
  })();
</script>
